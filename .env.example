# Copy to .env and fill in. See DEVDOC.md for where each value comes from.

# ---------------------------------------------------------------------------
# Browser-exposed (VITE_ prefixed values are bundled into the JS and public).
# The anon key is public by design; row-level security is what protects data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Server-side only. No VITE_ prefix, so Vite will never bundle these.
# Needed for: supabase link / db push / functions deploy / secrets set / gen types.
# ---------------------------------------------------------------------------

# supabase.com/dashboard/account/tokens -> "Generate new token" (starts sbp_)
SUPABASE_ACCESS_TOKEN=""

# Project Settings -> Database -> Database password
SUPABASE_DB_PASSWORD=""

# Project Settings -> API -> service_role (secret). Used by the admin edge
# function that deletes auth.users rows, and by test teardown.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Edge Function secrets - NOT read from this file. Set them with:
#   npx supabase secrets set KEY=value
# Listed here only so the full surface is documented in one place.
# ---------------------------------------------------------------------------
#   SELFHOST_JWT_SECRET    JWT_SECRET from the storage box's docker/.env
#   ORACLE_UPLOAD_BASE_URL https://supabase.dileepadari.dev
#   ORACLE_UPLOAD_PATH     /functions/v1/upload
#   ORACLE_PUBLIC_BASE_URL https://mystorage.dileepadari.dev
#   ORACLE_APP_NAME        placements
#   REMINDER_CRON_SECRET   openssl rand -hex 32
